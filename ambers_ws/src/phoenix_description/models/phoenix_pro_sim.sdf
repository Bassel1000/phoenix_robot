<?xml version="1.0"?>
<sdf version="1.9">
  <model name="phoenix">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- Base Footprint (Ground Projection) -->
    <link name="base_footprint">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Main Chassis: Deep Metallic Crimson Anodized Livery -->
    <link name="base_link">
      <pose>0 0 0.13 0 0 0</pose>
      <inertial>
        <mass>5.4</mass>
        <inertia>
          <ixx>0.07471</ixx><iyy>0.11530</iyy><izz>0.15402</izz>
        </inertia>
      </inertial>

      <!-- Main Hull Collision -->
      <collision name="collision_hull">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.465 0.355 0.20</size></box></geometry>
      </collision>

      <!-- Main Hull Visual: Deep Metallic Crimson -->
      <visual name="visual_hull">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.465 0.355 0.18</size></box></geometry>
        <material>
          <ambient>0.45 0.10 0.15 1.0</ambient>
          <diffuse>0.55 0.12 0.18 1.0</diffuse>
          <specular>0.60 0.30 0.35 1.0</specular>
        </material>
      </visual>

      <!-- Top Deck Armor Plate: Industrial Obsidian Black -->
      <visual name="visual_top_deck">
        <pose>0 0 0.115 0 0 0</pose>
        <geometry><box><size>0.45 0.34 0.01</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
          <specular>0.30 0.30 0.30 1.0</specular>
        </material>
      </visual>

      <!-- Brand Identity Accent Stripes: Molten Ember Orange -->
      <visual name="visual_flame_stripe_left">
        <pose>0 0.17 0.04 0 0 0</pose>
        <geometry><box><size>0.40 0.01 0.025</size></box></geometry>
        <material>
          <ambient>0.98 0.45 0.08 1.0</ambient>
          <diffuse>0.98 0.45 0.08 1.0</diffuse>
          <emissive>0.40 0.15 0.0 1.0</emissive>
        </material>
      </visual>
      <visual name="visual_flame_stripe_right">
        <pose>0 -0.17 0.04 0 0 0</pose>
        <geometry><box><size>0.40 0.01 0.025</size></box></geometry>
        <material>
          <ambient>0.98 0.45 0.08 1.0</ambient>
          <diffuse>0.98 0.45 0.08 1.0</diffuse>
          <emissive>0.40 0.15 0.0 1.0</emissive>
        </material>
      </visual>

      <!-- 2020 Aluminum Extrusion Arch - Left Column -->
      <visual name="arch_column_left">
        <pose>0.05 0.14 0.22 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.20</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.10 0.10 0.10 1.0</diffuse>
          <specular>0.25 0.25 0.25 1.0</specular>
        </material>
      </visual>

      <!-- 2020 Aluminum Extrusion Arch - Right Column -->
      <visual name="arch_column_right">
        <pose>0.05 -0.14 0.22 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.20</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.10 0.10 0.10 1.0</diffuse>
          <specular>0.25 0.25 0.25 1.0</specular>
        </material>
      </visual>

      <!-- 2020 Aluminum Extrusion Arch - Top Crossbeam -->
      <visual name="arch_crossbeam">
        <pose>0.05 0 0.32 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.02</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.10 0.10 0.10 1.0</diffuse>
          <specular>0.25 0.25 0.25 1.0</specular>
        </material>
      </visual>

      <!-- Okdo LD06 TOF LiDAR Cylinder Base & Turret -->
      <visual name="lidar_turret_housing">
        <pose>0.05 0 0.345 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.035</length></cylinder></geometry>
        <material>
          <ambient>0.04 0.04 0.05 1.0</ambient>
          <diffuse>0.06 0.06 0.08 1.0</diffuse>
          <specular>0.80 0.80 0.80 1.0</specular>
        </material>
      </visual>
      <visual name="lidar_optical_slot">
        <pose>0.05 0 0.355 0 0 0</pose>
        <geometry><cylinder><radius>0.038</radius><length>0.012</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.55 0.90 1.0</ambient>
          <diffuse>0.02 0.55 0.90 1.0</diffuse>
          <emissive>0.01 0.35 0.65 1.0</emissive>
        </material>
      </visual>

      <!-- 24V Diaphragm Pump Reservoir Enclosure -->
      <visual name="pump_enclosure">
        <pose>-0.08 0 0.14 0 0 0</pose>
        <geometry><box><size>0.18 0.20 0.08</size></box></geometry>
        <material>
          <ambient>0.85 0.88 0.92 1.0</ambient>
          <diffuse>0.85 0.88 0.92 1.0</diffuse>
          <specular>0.90 0.90 0.95 1.0</specular>
        </material>
      </visual>

      <!-- Front 2-DOF Gimbal Base Bracket -->
      <visual name="gimbal_base_bracket">
        <pose>0.22 0 0.11 0 0 0</pose>
        <geometry><box><size>0.04 0.08 0.04</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.10 0.10 0.10 1.0</diffuse>
        </material>
      </visual>

      <!-- Suppression Nozzle Tip: Aerospace Sky-Blue -->
      <visual name="nozzle_tip">
        <pose>0.26 0 0.12 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.45 0.75 1.0</ambient>
          <diffuse>0.05 0.55 0.90 1.0</diffuse>
          <specular>0.70 0.85 0.95 1.0</specular>
        </material>
      </visual>

      <!-- Status LED Indicators (Cybernetic Glow) -->
      <visual name="status_led_nav">
        <pose>0.23 0.12 0.12 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.0 0.9 0.6 1.0</ambient>
          <diffuse>0.0 0.9 0.6 1.0</diffuse>
          <emissive>0.0 0.9 0.6 1.0</emissive>
        </material>
      </visual>
      <visual name="status_led_hazard">
        <pose>0.23 -0.12 0.12 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <material>
          <ambient>0.98 0.45 0.08 1.0</ambient>
          <diffuse>0.98 0.45 0.08 1.0</diffuse>
          <emissive>0.98 0.45 0.08 1.0</emissive>
        </material>
      </visual>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <!-- Wheels: Sky-Blue Metallic Hubs with Industrial Gripped Tires -->
    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose relative_to="base_link">0.18 0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.0003</ixx><iyy>0.0005</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>0.08</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0001</slip1>
              <slip2>0.05</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.062</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.45 0.75 1.0</ambient>
          <diffuse>0.05 0.55 0.90 1.0</diffuse>
          <specular>0.70 0.85 0.95 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.18 0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.0003</ixx><iyy>0.0005</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>0.08</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0001</slip1>
              <slip2>0.05</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.062</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.45 0.75 1.0</ambient>
          <diffuse>0.05 0.55 0.90 1.0</diffuse>
          <specular>0.70 0.85 0.95 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.18 -0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.0003</ixx><iyy>0.0005</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>0.08</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0001</slip1>
              <slip2>0.05</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.062</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.45 0.75 1.0</ambient>
          <diffuse>0.05 0.55 0.90 1.0</diffuse>
          <specular>0.70 0.85 0.95 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.18 -0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.0003</ixx><iyy>0.0005</iyy><izz>0.0003</izz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>0.08</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.0001</slip1>
              <slip2>0.05</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
      <visual name="hub">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.062</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.45 0.75 1.0</ambient>
          <diffuse>0.05 0.55 0.90 1.0</diffuse>
          <specular>0.70 0.85 0.95 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- Revolute Drive Wheel Joints -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis>
    </joint>

    <!-- FPV Camera Sensor Link -->
    <link name="camera_link">
      <pose relative_to="base_link">0.24 0 0.19 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.03 0.05 0.03</size></box></geometry>
        <material>
          <ambient>0.05 0.06 0.09 1</ambient>
          <diffuse>0.05 0.06 0.09 1</diffuse>
        </material>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.309</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <!-- LiDAR Sensor Link (Okdo LD06 TOF) -->
    <link name="lidar_link">
      <pose relative_to="base_link">0.05 0 0.355 0 0 0</pose>
      <sensor name="lidar_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.283185</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <!-- 4-Wheel Differential Drive Plugin -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.38</wheel_separation>
      <wheel_radius>0.065</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <topic>/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </model>
</sdf>
