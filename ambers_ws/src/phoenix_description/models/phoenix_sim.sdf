<?xml version="1.0"?>
<sdf version="1.9">
  <model name="phoenix">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_footprint">
      <inertial><mass>5.4</mass><inertia><ixx>0.07471</ixx><iyy>0.11530</iyy><izz>0.15402</izz></inertia></inertial>
    </link>
    <link name="base_link">
      <pose>0 0 0.13 0 0 0</pose>
      <inertial><mass>5.4</mass><inertia><ixx>0.07471</ixx><iyy>0.11530</iyy><izz>0.15402</izz></inertia></inertial>
      <collision name="collision"><pose>0 0 0.02 0 0 0</pose><geometry><box><size>0.42 0.32 0.16</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.465 0.355 0.2</size></box></geometry><material><ambient>0.51 0.11 0.17 1</ambient><diffuse>0.51 0.11 0.17 1</diffuse></material></visual>
    </link>
    <joint name="base_footprint_joint" type="fixed"><parent>base_footprint</parent><child>base_link</child></joint>

    <link name="front_left_wheel">
      <pose relative_to="base_link">0.2 0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00025</ixx><iyy>0.00042</iyy><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.05</mu2><fdir1>1 0 0</fdir1><slip1>0.0001</slip1><slip2>0.05</slip2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.55 0.90 1</ambient><diffuse>0.05 0.55 0.90 1</diffuse></material></visual>
    </link>
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.2 0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00025</ixx><iyy>0.00042</iyy><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.05</mu2><fdir1>1 0 0</fdir1><slip1>0.0001</slip1><slip2>0.05</slip2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.55 0.90 1</ambient><diffuse>0.05 0.55 0.90 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.2 -0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00025</ixx><iyy>0.00042</iyy><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.05</mu2><fdir1>1 0 0</fdir1><slip1>0.0001</slip1><slip2>0.05</slip2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.55 0.90 1</ambient><diffuse>0.05 0.55 0.90 1</diffuse></material></visual>
    </link>
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.2 -0.19 -0.065 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00025</ixx><iyy>0.00042</iyy><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.05</mu2><fdir1>1 0 0</fdir1><slip1>0.0001</slip1><slip2>0.05</slip2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.065</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.55 0.90 1</ambient><diffuse>0.05 0.55 0.90 1</diffuse></material></visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis></joint>
    <joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.01</friction></dynamics></axis></joint>

    <link name="camera_link">
      <pose relative_to="base_link">0.24 0 0.20 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.03 0.05 0.03</size></box></geometry>
        <material><ambient>0.05 0.06 0.09 1</ambient><diffuse>0.05 0.06 0.09 1</diffuse></material>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.309</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <link name="lidar_link">
      <pose relative_to="base_link">0.1 0 0.3 0 0 0</pose>
      <sensor name="lidar_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>6.283185</max_angle></horizontal></scan>
          <range><min>0.05</min><max>10.0</max><resolution>0.01</resolution></range>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.38</wheel_separation>
      <wheel_radius>0.065</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <topic>/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </model>
</sdf>
