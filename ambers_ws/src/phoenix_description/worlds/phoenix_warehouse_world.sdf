<?xml version="1.0"?>
<sdf version="1.9">
  <world name="phoenix_warehouse_world">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- High-Bay Industrial Sodium / Warehouse Ambient Lighting -->
    <scene>
      <ambient>0.25 0.24 0.22 1.0</ambient>
      <background>0.10 0.10 0.10 1.0</background>
      <grid>false</grid>
    </scene>

    <light type="spot" name="bay_spot_1">
      <pose>1.5 0 4.0 0 0 0</pose>
      <diffuse>0.95 0.90 0.80 1.0</diffuse>
      <specular>0.3 0.3 0.2 1.0</specular>
      <attenuation><range>9.0</range><constant>0.5</constant><linear>0.06</linear></attenuation>
      <spot><inner_angle>0.9</inner_angle><outer_angle>1.5</outer_angle><falloff>1.0</falloff></spot>
      <direction>0 0 -1</direction>
    </light>
    <light type="spot" name="bay_spot_2">
      <pose>4.2 0 4.0 0 0 0</pose>
      <diffuse>0.95 0.90 0.80 1.0</diffuse>
      <specular>0.3 0.3 0.2 1.0</specular>
      <attenuation><range>9.0</range><constant>0.5</constant><linear>0.06</linear></attenuation>
      <spot><inner_angle>0.9</inner_angle><outer_angle>1.5</outer_angle><falloff>1.0</falloff></spot>
      <direction>0 0 -1</direction>
    </light>

    <!-- Cargo Fire Flame Glow Light -->
    <light type="point" name="pallet_fire_glow">
      <pose>3.8 1.2 0.8 0 0 0</pose>
      <diffuse>1.0 0.50 0.05 1.0</diffuse>
      <specular>0.9 0.4 0.0 1.0</specular>
      <attenuation><range>7.0</range><constant>0.35</constant><linear>0.12</linear><quadratic>0.04</quadratic></attenuation>
    </light>

    <!-- Polished Industrial Concrete Floor with Hazard Striping -->
    <model name="warehouse_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>16 12</size></plane></geometry>
        </collision>
        <visual name="concrete_surface">
          <geometry><plane><normal>0 0 1</normal><size>16 12</size></plane></geometry>
          <material>
            <ambient>0.30 0.29 0.27 1.0</ambient>
            <diffuse>0.40 0.38 0.36 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
        <!-- Yellow Safety Walking Lane Left -->
        <visual name="safety_lane_left">
          <pose>2.5 1.1 0.001 0 0 0</pose>
          <geometry><box><size>8.0 0.08 0.002</size></box></geometry>
          <material><ambient>0.95 0.8 0 1</ambient><diffuse>0.95 0.8 0 1</diffuse></material>
        </visual>
        <!-- Yellow Safety Walking Lane Right -->
        <visual name="safety_lane_right">
          <pose>2.5 -1.1 0.001 0 0 0</pose>
          <geometry><box><size>8.0 0.08 0.002</size></box></geometry>
          <material><ambient>0.95 0.8 0 1</ambient><diffuse>0.95 0.8 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer Warehouse Perimeter Walls -->
    <model name="wh_north_wall">
      <static>true</static><pose>2.5 5.5 2.0 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>15 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>15 0.2 4.0</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.28 0.3 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wh_south_wall">
      <static>true</static><pose>2.5 -5.5 2.0 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>15 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>15 0.2 4.0</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.28 0.3 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wh_east_wall">
      <static>true</static><pose>8.0 0 2.0 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>11 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>11 0.2 4.0</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.28 0.3 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wh_west_wall">
      <static>true</static><pose>-3.0 0 2.0 0 0 1.5708</pose>
      <link name="link"><collision name="c"><geometry><box><size>11 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>11 0.2 4.0</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.28 0.3 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         HIGH-BAY INDUSTRIAL STORAGE RACKS (North Side)
         ════════════════════════════════════════════════════════════════ -->
    <!-- Pallet Rack A1 -->
    <model name="pallet_rack_A1">
      <static>true</static>
      <pose>1.0 1.8 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.6 1.0 2.8</size></box></geometry></collision>
        <!-- Blue Upright Frame -->
        <visual name="frame"><geometry><box><size>1.6 1.0 2.8</size></box></geometry>
          <material><ambient>0.08 0.25 0.55 1</ambient><diffuse>0.1 0.35 0.7 1</diffuse></material>
        </visual>
        <!-- Orange Crossbeams -->
        <visual name="beam_mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.62 1.02 0.08</size></box></geometry>
          <material><ambient>0.9 0.4 0 1</ambient><diffuse>0.95 0.45 0 1</diffuse></material>
        </visual>
        <!-- Cardboard Boxes on Lower Shelf -->
        <visual name="boxes_low"><pose>-0.3 0 -0.5 0 0 0</pose><geometry><box><size>0.65 0.7 0.6</size></box></geometry>
          <material><ambient>0.6 0.45 0.28 1</ambient><diffuse>0.72 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pallet Rack A2 (Near Incident) -->
    <model name="pallet_rack_A2">
      <static>true</static>
      <pose>3.0 1.8 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.6 1.0 2.8</size></box></geometry></collision>
        <visual name="frame"><geometry><box><size>1.6 1.0 2.8</size></box></geometry>
          <material><ambient>0.08 0.25 0.55 1</ambient><diffuse>0.1 0.35 0.7 1</diffuse></material>
        </visual>
        <visual name="beam_mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.62 1.02 0.08</size></box></geometry>
          <material><ambient>0.9 0.4 0 1</ambient><diffuse>0.95 0.45 0 1</diffuse></material>
        </visual>
        <visual name="boxes"><pose>0.2 0 0.5 0 0 0</pose><geometry><box><size>0.8 0.7 0.7</size></box></geometry>
          <material><ambient>0.6 0.45 0.28 1</ambient><diffuse>0.72 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pallet Rack A3 -->
    <model name="pallet_rack_A3">
      <static>true</static>
      <pose>5.0 1.8 1.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.6 1.0 2.8</size></box></geometry></collision>
        <visual name="frame"><geometry><box><size>1.6 1.0 2.8</size></box></geometry>
          <material><ambient>0.08 0.25 0.55 1</ambient><diffuse>0.1 0.35 0.7 1</diffuse></material>
        </visual>
        <visual name="beam_mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>1.62 1.02 0.08</size></box></geometry>
          <material><ambient>0.9 0.4 0 1</ambient><diffuse>0.95 0.45 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         HIGH-BAY INDUSTRIAL STORAGE RACKS (South Side)
         ════════════════════════════════════════════════════════════════ -->
    <model name="pallet_rack_B1">
      <static>true</static><pose>1.0 -1.8 1.4 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>1.6 1.0 2.8</size></box></geometry></collision>
        <visual name="frame"><geometry><box><size>1.6 1.0 2.8</size></box></geometry>
          <material><ambient>0.08 0.25 0.55 1</ambient><diffuse>0.1 0.35 0.7 1</diffuse></material>
        </visual>
        <visual name="boxes"><pose>0 0 -0.4 0 0 0</pose><geometry><box><size>0.9 0.8 0.6</size></box></geometry>
          <material><ambient>0.6 0.45 0.28 1</ambient><diffuse>0.72 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_rack_B2">
      <static>true</static><pose>3.0 -1.8 1.4 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>1.6 1.0 2.8</size></box></geometry></collision>
        <visual name="frame"><geometry><box><size>1.6 1.0 2.8</size></box></geometry>
          <material><ambient>0.08 0.25 0.55 1</ambient><diffuse>0.1 0.35 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_rack_B3">
      <static>true</static><pose>5.0 -1.8 1.4 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>1.6 1.0 2.8</size></box></geometry></collision>
        <visual name="frame"><geometry><box><size>1.6 1.0 2.8</size></box></geometry>
          <material><ambient>0.08 0.25 0.55 1</ambient><diffuse>0.1 0.35 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         DYNAMIC OBSTACLE: DROPPED PALLET & CARGO DRUM
         Forces Nav2 to dynamically replan path in aisle
         ════════════════════════════════════════════════════════════════ -->
    <model name="aisle_cargo_obstacle">
      <static>true</static>
      <pose>2.4 -0.20 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.26</radius><length>0.7</length></cylinder></geometry></collision>
        <!-- Blue Industrial Chemical Drum -->
        <visual name="drum"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.26</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.05 0.25 0.75 1</ambient><diffuse>0.08 0.35 0.85 1</diffuse></material>
        </visual>
        <!-- Danger / Flammable Hazard Diamond -->
        <visual name="hazard_label"><pose>0.265 0 0.1 0 0 0</pose><geometry><box><size>0.01 0.15 0.15</size></box></geometry>
          <material><ambient>0.95 0.1 0.05 1</ambient><diffuse>0.95 0.1 0.05 1</diffuse><emissive>0.6 0 0 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         CASUALTY: COLLAPSED WAREHOUSE LOGISTICS WORKER
         Positioned near Rack B1, visual-only (no collision to prevent Nav2 blocking)
         ════════════════════════════════════════════════════════════════ -->
    <model name="warehouse_worker_casualty">
      <static>true</static>
      <pose>1.2 -0.65 0.08 0 0 -0.2</pose>
      <link name="link">
        <!-- Body: Heavy Duty Grey Work Wear -->
        <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.90 0.42 0.18</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.3 0.32 0.35 1</diffuse></material>
        </visual>
        <!-- Bright Fluorescent Orange High-Vis Vest -->
        <visual name="vest"><pose>0.1 0 0.02 0 0 0</pose><geometry><box><size>0.45 0.43 0.17</size></box></geometry>
          <material><ambient>1 0.35 0 1</ambient><diffuse>1 0.4 0 1</diffuse><emissive>0.6 0.2 0 1</emissive></material>
        </visual>
        <!-- Yellow Industrial Hard Hat -->
        <visual name="helmet"><pose>0.55 0 0.05 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>0.95 0.8 0 1</ambient><diffuse>0.95 0.8 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         FIRE HAZARD: IGNITED CARGO PALLET & CARTONS
         Location: (3.8, 1.1, 0.35) - Visual-only flame for clean 30cm standoff
         ════════════════════════════════════════════════════════════════ -->
    <model name="fire_target">
      <static>true</static>
      <pose>3.8 1.1 0.35 0 0 0</pose>
      <link name="link">
        
        <!-- Burning Wooden Pallet Base -->
        <visual name="pallet_base">
          <pose>0 0 -0.2 0 0 0</pose>
          <geometry><box><size>0.6 0.6 0.1</size></box></geometry>
          <material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.25 0.12 0.05 1</diffuse></material>
        </visual>

        <!-- Core Flame (White-Yellow Intensity) -->
        <visual name="flame_core">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><cone><radius>0.09</radius><length>0.4</length></cone></geometry>
          <material>
            <ambient>1.0 0.95 0.5 1.0</ambient>
            <diffuse>1.0 0.95 0.5 1.0</diffuse>
            <emissive>1.0 0.95 0.6 1.0</emissive>
          </material>
        </visual>

        <!-- Outer Flame Flare (Vibrant Orange-Red) -->
        <visual name="flame_outer">
          <pose>0 0 0.06 0 0 0</pose>
          <geometry><cone><radius>0.22</radius><length>0.5</length></cone></geometry>
          <material>
            <ambient>1.0 0.35 0.0 1.0</ambient>
            <diffuse>1.0 0.35 0.0 1.0</diffuse>
            <emissive>0.98 0.30 0.0 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
