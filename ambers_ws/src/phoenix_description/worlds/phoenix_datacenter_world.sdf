<?xml version="1.0"?>
<sdf version="1.9">
  <world name="phoenix_datacenter_world">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Ambient Datacenter Lighting: Cool Slate Blue & Dark Grid -->
    <scene>
      <ambient>0.15 0.18 0.25 1.0</ambient>
      <background>0.05 0.07 0.10 1.0</background>
      <grid>false</grid>
    </scene>

    <!-- Overhead Cool-White Aisle Strip Lighting -->
    <light type="spot" name="aisle_spot_1">
      <pose>1.5 0 3.2 0 0 0</pose>
      <diffuse>0.85 0.92 1.0 1.0</diffuse>
      <specular>0.4 0.4 0.5 1.0</specular>
      <attenuation><range>8.0</range><constant>0.6</constant><linear>0.08</linear></attenuation>
      <spot><inner_angle>0.8</inner_angle><outer_angle>1.4</outer_angle><falloff>1.0</falloff></spot>
      <direction>0 0 -1</direction>
    </light>
    <light type="spot" name="aisle_spot_2">
      <pose>4.0 0 3.2 0 0 0</pose>
      <diffuse>0.85 0.92 1.0 1.0</diffuse>
      <specular>0.4 0.4 0.5 1.0</specular>
      <attenuation><range>8.0</range><constant>0.6</constant><linear>0.08</linear></attenuation>
      <spot><inner_angle>0.8</inner_angle><outer_angle>1.4</outer_angle><falloff>1.0</falloff></spot>
      <direction>0 0 -1</direction>
    </light>

    <!-- Thermal Hazard Warning Glow (Pulsing Orange Light from Fire) -->
    <light type="point" name="fire_heat_glow">
      <pose>4.0 1.0 0.8 0 0 0</pose>
      <diffuse>1.0 0.45 0.08 1.0</diffuse>
      <specular>0.8 0.3 0.0 1.0</specular>
      <attenuation><range>6.0</range><constant>0.4</constant><linear>0.15</linear><quadratic>0.05</quadratic></attenuation>
    </light>

    <!-- High-Tech Anti-Static Datacenter Floor -->
    <model name="datacenter_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>16 12</size></plane></geometry>
        </collision>
        <visual name="floor_surface">
          <geometry><plane><normal>0 0 1</normal><size>16 12</size></plane></geometry>
          <material>
            <ambient>0.08 0.10 0.14 1.0</ambient>
            <diffuse>0.12 0.15 0.20 1.0</diffuse>
            <specular>0.35 0.35 0.40 1.0</specular>
          </material>
        </visual>
        <!-- Aisle Safety Perimeter Striping (Cyber Blue) -->
        <visual name="aisle_border_left">
          <pose>2.5 0.9 0.001 0 0 0</pose>
          <geometry><box><size>7.0 0.06 0.002</size></box></geometry>
          <material>
            <ambient>0.02 0.55 0.90 1.0</ambient>
            <diffuse>0.02 0.55 0.90 1.0</diffuse>
            <emissive>0.01 0.35 0.65 1.0</emissive>
          </material>
        </visual>
        <visual name="aisle_border_right">
          <pose>2.5 -0.9 0.001 0 0 0</pose>
          <geometry><box><size>7.0 0.06 0.002</size></box></geometry>
          <material>
            <ambient>0.02 0.55 0.90 1.0</ambient>
            <diffuse>0.02 0.55 0.90 1.0</diffuse>
            <emissive>0.01 0.35 0.65 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Architectural Enclosure Walls -->
    <model name="north_wall">
      <static>true</static>
      <pose>2.5 5.5 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>15 0.2 3.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>15 0.2 3.5</size></box></geometry>
          <material><ambient>0.06 0.08 0.11 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>2.5 -5.5 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>15 0.2 3.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>15 0.2 3.5</size></box></geometry>
          <material><ambient>0.06 0.08 0.11 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>8.0 0 1.75 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>11 0.2 3.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>11 0.2 3.5</size></box></geometry>
          <material><ambient>0.06 0.08 0.11 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-3.0 0 1.75 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>11 0.2 3.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>11 0.2 3.5</size></box></geometry>
          <material><ambient>0.06 0.08 0.11 1</ambient><diffuse>0.08 0.10 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         SERVER RACK BANK A (North / Left Side of Cold Aisle)
         ════════════════════════════════════════════════════════════════ -->
    <!-- Server Rack 1 -->
    <model name="server_rack_A1">
      <static>true</static>
      <pose>0.5 1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <!-- Server Faceplates & Blinking Status LEDs -->
        <visual name="led_strip"><pose>0 -0.48 0.4 0 0 0</pose><geometry><box><size>0.7 0.01 0.03</size></box></geometry>
          <material><ambient>0 0.8 0.5 1</ambient><diffuse>0 0.8 0.5 1</diffuse><emissive>0 0.8 0.5 1</emissive></material>
        </visual>
        <visual name="led_strip2"><pose>0 -0.48 -0.2 0 0 0</pose><geometry><box><size>0.7 0.01 0.03</size></box></geometry>
          <material><ambient>0.02 0.55 0.9 1</ambient><diffuse>0.02 0.55 0.9 1</diffuse><emissive>0.02 0.55 0.9 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Server Rack 2 -->
    <model name="server_rack_A2">
      <static>true</static>
      <pose>1.5 1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <visual name="led_strip"><pose>0 -0.48 0.2 0 0 0</pose><geometry><box><size>0.7 0.01 0.03</size></box></geometry>
          <material><ambient>0 0.8 0.5 1</ambient><diffuse>0 0.8 0.5 1</diffuse><emissive>0 0.8 0.5 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Server Rack 3 -->
    <model name="server_rack_A3">
      <static>true</static>
      <pose>2.5 1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <visual name="led_strip"><pose>0 -0.48 0.5 0 0 0</pose><geometry><box><size>0.7 0.01 0.03</size></box></geometry>
          <material><ambient>0.02 0.55 0.9 1</ambient><diffuse>0.02 0.55 0.9 1</diffuse><emissive>0.02 0.55 0.9 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Server Rack 4: INCIDENT LOCATION (Thermal Runaway Cabinet) -->
    <model name="server_rack_A4_incident">
      <static>true</static>
      <pose>3.7 1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.15 0.05 0.05 1</ambient><diffuse>0.18 0.06 0.06 1</diffuse><specular>0.5 0.2 0.2 1</specular></material>
        </visual>
        <!-- Critical Thermal Alarm Bar -->
        <visual name="alarm_led"><pose>0 -0.48 0.6 0 0 0</pose><geometry><box><size>0.75 0.02 0.06</size></box></geometry>
          <material><ambient>1 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse><emissive>1 0.1 0.1 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Server Rack 5 -->
    <model name="server_rack_A5">
      <static>true</static>
      <pose>4.9 1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
        </visual>
        <visual name="led_strip"><pose>0 -0.48 0.1 0 0 0</pose><geometry><box><size>0.7 0.01 0.03</size></box></geometry>
          <material><ambient>0 0.8 0.5 1</ambient><diffuse>0 0.8 0.5 1</diffuse><emissive>0 0.8 0.5 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         SERVER RACK BANK B (South / Right Side of Cold Aisle)
         ════════════════════════════════════════════════════════════════ -->
    <model name="server_rack_B1">
      <static>true</static>
      <pose>0.5 -1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse></material>
        </visual>
        <visual name="led"><pose>0 0.48 0.3 0 0 0</pose><geometry><box><size>0.7 0.01 0.03</size></box></geometry>
          <material><ambient>0.02 0.55 0.9 1</ambient><diffuse>0.02 0.55 0.9 1</diffuse><emissive>0.02 0.55 0.9 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="server_rack_B2">
      <static>true</static>
      <pose>1.5 -1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="server_rack_B3">
      <static>true</static>
      <pose>2.5 -1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse></material>
        </visual>
        <visual name="led"><pose>0 0.48 0.4 0 0 0</pose><geometry><box><size>0.7 0.01 0.03</size></box></geometry>
          <material><ambient>0 0.8 0.5 1</ambient><diffuse>0 0.8 0.5 1</diffuse><emissive>0 0.8 0.5 1</emissive></material>
        </visual>
      </link>
    </model>

    <model name="server_rack_B4">
      <static>true</static>
      <pose>3.7 -1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="server_rack_B5">
      <static>true</static>
      <pose>4.9 -1.55 1.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.85 0.95 2.2</size></box></geometry></collision>
        <visual name="cabinet"><geometry><box><size>0.85 0.95 2.2</size></box></geometry>
          <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.07 0.07 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         DYNAMIC OBSTACLE: SERVER MAINTENANCE CRASH CART
         Requires Nav2 to recalculate path live during demo
         ════════════════════════════════════════════════════════════════ -->
    <model name="maintenance_cart">
      <static>true</static>
      <pose>2.3 0.18 0.42 0 0 0.15</pose>
      <link name="link">
        <collision name="col_body"><geometry><box><size>0.55 0.45 0.80</size></box></geometry></collision>
        <!-- Shelf Frames -->
        <visual name="cart_body"><geometry><box><size>0.55 0.45 0.76</size></box></geometry>
          <material><ambient>0.7 0.7 0.72 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
        </visual>
        <!-- Crash-Cart Laptop Screen (Active Diagnostic) -->
        <visual name="laptop_screen"><pose>0.05 0 0.42 0 -0.3 0</pose><geometry><box><size>0.24 0.32 0.015</size></box></geometry>
          <material><ambient>0 0.6 0.9 1</ambient><diffuse>0 0.6 0.9 1</diffuse><emissive>0 0.6 0.9 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         CASUALTY: COLLAPSED DATACENTER TECHNICIAN (LIFE DETECTION)
         Positioned near Rack B2, visual-only (no collision to prevent Nav2 blocking)
         ════════════════════════════════════════════════════════════════ -->
    <model name="technician_casualty">
      <static>true</static>
      <pose>1.2 -0.65 0.08 0 0 -0.2</pose>
      <link name="link">
        <!-- Body: Blue Safety Jumpsuit -->
        <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.90 0.42 0.18</size></box></geometry>
          <material><ambient>0.10 0.25 0.65 1</ambient><diffuse>0.15 0.35 0.80 1</diffuse></material>
        </visual>
        <!-- High-Visibility Safety Vest -->
        <visual name="vest"><pose>0.1 0 0.02 0 0 0</pose><geometry><box><size>0.45 0.43 0.17</size></box></geometry>
          <material><ambient>0.9 0.85 0.05 1</ambient><diffuse>0.95 0.9 0.05 1</diffuse><emissive>0.4 0.4 0.0 1</emissive></material>
        </visual>
        <!-- Head & Safety Helmet -->
        <visual name="helmet"><pose>0.55 0 0.05 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════
         FIRE HAZARD: ELECTRICAL UPS THERMAL RUNAWAY AT SERVER RACK 4
         Location: (3.7, 0.95, 0.35) - Visual-only flame for clean 30cm standoff
         ════════════════════════════════════════════════════════════════ -->
    <model name="fire_target">
      <static>true</static>
      <pose>3.7 0.95 0.35 0 0 0</pose>
      <link name="link">
        
        <!-- Core Emissive Flame (Layer 1 - White Hot Center) -->
        <visual name="flame_core">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry><cone><radius>0.08</radius><length>0.35</length></cone></geometry>
          <material>
            <ambient>1.0 0.95 0.6 1.0</ambient>
            <diffuse>1.0 0.95 0.6 1.0</diffuse>
            <emissive>1.0 0.95 0.7 1.0</emissive>
          </material>
        </visual>

        <!-- Outer Flame Flare (Layer 2 - Molten Orange) -->
        <visual name="flame_outer">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><cone><radius>0.18</radius><length>0.45</length></cone></geometry>
          <material>
            <ambient>1.0 0.45 0.0 1.0</ambient>
            <diffuse>1.0 0.45 0.0 1.0</diffuse>
            <emissive>0.98 0.40 0.0 1.0</emissive>
          </material>
        </visual>

        <!-- Thermal Plume Base (Layer 3 - Burning Carbon Ember) -->
        <visual name="ember_base">
          <pose>0 0 -0.15 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.10</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.15 0.02 1.0</ambient>
            <diffuse>0.9 0.2 0.02 1.0</diffuse>
            <emissive>0.7 0.1 0.0 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ArUco Spatial Calibration Target Board on East Wall -->
    <model name="aruco_marker_board">
      <static>true</static>
      <pose>7.88 0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="board"><geometry><box><size>0.02 0.6 0.6</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="marker_black"><pose>-0.01 0 0 0 0 0</pose><geometry><box><size>0.02 0.45 0.45</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="marker_center"><pose>-0.015 0 0 0 0 0</pose><geometry><box><size>0.02 0.22 0.22</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
