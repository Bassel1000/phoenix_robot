# Phoenix AI Vision Environment Configuration

# 1. Raspberry Pi MQTT Broker IP
MQTT_BROKER=192.168.137.163

# 2. Overhead Surveillance Camera Source
# Options:
# - RTSP Stream: rtsp://username:password@192.168.1.20:554/stream1
# - DroidCam Virtual Webcam on Windows: 1 (or 0 if no built-in webcam)
# - DroidCam Wi-Fi MJPEG: http://<PHONE_IP>:4747/video
RTSP_URL=1

# 3. Pi Forward FPV Camera (leave commented out for standby mode)
# PI_CAMERA_URL=tcp://192.168.137.163:8889

# 4. Optional Desktop OpenCV Windows (0 = Web HUD only (recommended), 1 = Desktop popups)
SHOW_CV2_WINDOWS=0